# Server gRPC privat. Gunakan UDS bila caller berada di host yang sama;
# gunakan http://HOST:PORT untuk caller lintas server/platform.
EPOSYANDU_DATA_PROCESSING_GRPC_ADDR=unix:///tmp/e-posyandu/data-processing.sock
EPOSYANDU_DATA_PROCESSING_GRPC_URL=unix:///tmp/e-posyandu/data-processing.sock
# Alamat listener worker yang dipakai Queue consumer; gunakan socket yang sama
# dengan DATA_PROCESSING_GRPC_ADDR pada deployment satu host.
# GRPC_ADDR/GRPC_URL tetap diterima sebagai alias kompatibilitas.
# Dibutuhkan untuk autentikasi metadata gRPC saat service dipanggil oleh API.
EPOSYANDU_SHARED_SECRET=replace-with-private-service-secret

# Biarkan false bila hanya ingin menjalankan server gRPC lokal.
EPOSYANDU_QUEUE_CONSUMER_ENABLED=false
EPOSYANDU_QUEUE_BATCH_SIZE=5
EPOSYANDU_QUEUE_POLL_INTERVAL_MS=1500

# Wajib hanya ketika Queue consumer diaktifkan.
EPOSYANDU_QUEUE_API_URL=https://queue.example.invalid/v1/{queue_id}/messages
EPOSYANDU_QUEUE_ACCOUNT_ID=
EPOSYANDU_QUEUE_ID=demo-queue
EPOSYANDU_QUEUE_TOKEN=replace-with-queue-token
EPOSYANDU_API_URL=https://api.example.invalid
