# Konfigurasi provider-neutral E-Posyandu.
# Ganti semua nilai contoh sebelum dipakai di staging/production.

EPOSYANDU_ENVIRONMENT=development
EPOSYANDU_API_LISTEN_ADDR=0.0.0.0:8081
EPOSYANDU_API_URL=http://127.0.0.1:8081
EPOSYANDU_PUBLIC_ORIGIN=http://127.0.0.1:5176

# Database PostgreSQL pilihan Anda.
EPOSYANDU_DATABASE_URL=postgresql://app:change-me@127.0.0.1:5432/eposyandu
EPOSYANDU_DATABASE_POOL_SIZE=5
EPOSYANDU_DATABASE_POOL_WAIT_TIMEOUT_SECONDS=2
EPOSYANDU_DATABASE_POOL_CREATE_TIMEOUT_SECONDS=5
EPOSYANDU_DATABASE_POOL_RECYCLE_TIMEOUT_SECONDS=2

# Cache atau Redis-compatible adapter (opsional untuk mode sederhana).
EPOSYANDU_CACHE_URL=redis://127.0.0.1:6379/0

# Queue adapter. Account ID boleh dikosongkan jika provider tidak memerlukannya.
EPOSYANDU_QUEUE_CONSUMER_ENABLED=false
EPOSYANDU_QUEUE_API_URL=https://queue.example.invalid/v1/{queue_id}/messages
EPOSYANDU_QUEUE_ACCOUNT_ID=
EPOSYANDU_QUEUE_ID=demo-queue
EPOSYANDU_QUEUE_TOKEN=replace-with-queue-token
EPOSYANDU_QUEUE_BATCH_SIZE=5
EPOSYANDU_QUEUE_POLL_INTERVAL_MS=1500

# Komunikasi internal dan worker.
EPOSYANDU_SHARED_SECRET=replace-with-private-service-secret
EPOSYANDU_DATA_PROCESSING_GRPC_URL=unix:///tmp/e-posyandu/data-processing.sock

# S3-compatible/object storage adapter (opsional).
EPOSYANDU_STORAGE_ENDPOINT=http://127.0.0.1:9000
EPOSYANDU_STORAGE_BUCKET=eposyandu
EPOSYANDU_STORAGE_ACCESS_KEY=change-me
EPOSYANDU_STORAGE_SECRET_KEY=change-me

# Authentication adapter pilihan Anda (opsional bila memakai auth native).
# Adapter auth yang sudah tersedia memakai kontrak API auth existing; buat
# adapter baru jika provider tujuan memakai protokol berbeda.
EPOSYANDU_AUTH_URL=https://auth.example.invalid
EPOSYANDU_AUTH_PUBLIC_KEY=
EPOSYANDU_AUTH_SECRET_KEY=

# Nama lama seperti ORACLE_DATABASE_URL atau CLOUDFLARE_QUEUE_ID masih
# diterima oleh adapter kompatibilitas, tetapi tidak diperlukan untuk instalasi
# baru. Jangan commit secret ke repository.
