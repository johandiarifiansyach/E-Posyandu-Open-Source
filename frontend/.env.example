# All application pages are served by the React frontend.

# In local development, leave empty to use the Vite /api proxy.
VITE_API_URL=
VITE_DEV_API_TARGET=http://127.0.0.1:8081
# Local Vite development accepts the demo accounts listed in the root README.
# This path is disabled automatically in production builds.
VITE_DEMO_AUTH=true
# Optional override for local demonstrations only. Default: Demo123!
VITE_DEMO_PASSWORD=Demo123!
