{
  "name": "e-posyandu",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "3.8.1",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "frontend:react:dev": "npm --prefix frontend run dev",
    "frontend:react:build": "npm --prefix frontend run build",
    "frontend:react:bundle": "npm --prefix frontend run bundle:visualize",
    "frontend:react:assets": "./scripts/assets/optimize-frontend-images.sh",
    "frontend:styling:check": "node scripts/verify-frontend-styling.mjs",
    "frontend:react:check": "npm run frontend:styling:check && npm --prefix frontend run typecheck",
    "frontend:react:test": "npm --prefix frontend exec -- playwright test --config=frontend/playwright.config.ts",
    "frontend:react:perf": "npm --prefix frontend exec -- playwright test --config=frontend/playwright.config.ts --grep @performance --project=chromium",
    "pages:build:react": "VITE_API_URL= npm --prefix frontend run build",
    "pages:deploy:react": "npm run pages:build:react && npx --yes wrangler pages deploy frontend/dist --project-name e-posyandu --branch main",
    "build": "npm run frontend:react:build",
    "check": "npm run frontend:check",
    "check:quality": "npm run frontend:check",
    "frontend:check": "npm run frontend:react:check",
    "integration:test": "node --test tests/integration/*.test.mjs",
    "frontend:test": "npm run frontend:react:test",
    "e2e:test": "npm run frontend:react:test",
    "ci": "npm run check && npm run build",
    "ci:react": "npm run check && npm run pages:build:react",
    "db:migrate": "./scripts/database/migrate.sh",
    "db:backup": "./scripts/database/backup.sh",
    "db:backup:verify": "./scripts/database/verify-backup.sh",
    "db:restore-drill": "./scripts/database/restore-drill.sh",
    "deployment:smoke": "node scripts/operations/smoke-deployment.mjs",
    "monitor:system": "node scripts/operations/monitor-system.mjs",
    "load:queue": "node scripts/operations/load-queue.mjs",
    "env:check": "./scripts/environment/check-database-isolation.sh",
    "r2:prepare": "./scripts/storage/prepare-r2.sh",
    "legacy:worker:check": "cargo check --manifest-path backend/legacy-cloudflare-worker/Cargo.toml",
    "legacy:worker:test": "cargo test --manifest-path backend/legacy-cloudflare-worker/Cargo.toml",
    "legacy:worker:dev": "npx --yes wrangler --cwd backend/legacy-cloudflare-worker dev --env development --ip 127.0.0.1 --port 8787",
    "data-processing:check": "cargo check --manifest-path backend/services/data-processing-service/Cargo.toml",
    "data-processing:test": "cargo test --manifest-path backend/services/data-processing-service/Cargo.toml",
    "data-processing:build": "cargo build --locked --release --manifest-path backend/services/data-processing-service/Cargo.toml",
    "data-processing:dev": "cargo run --manifest-path backend/services/data-processing-service/Cargo.toml",
    "data-processing:load": "cargo run --locked --bin data-processing-load --manifest-path backend/services/data-processing-service/Cargo.toml",
    "data-processing:check:cloud": "cargo check --locked --bin data-processing-cloud --manifest-path backend/services/data-processing-service/Cargo.toml",
    "grpc:check": "npm run data-processing:check",
    "grpc:test": "npm run data-processing:test",
    "grpc:build": "npm run data-processing:build",
    "grpc:dev": "npm run data-processing:dev",
    "grpc:load": "npm run data-processing:load",
    "grpc:check:cloud": "npm run data-processing:check:cloud",
    "oracle:api:check": "cargo check --locked --manifest-path backend/services/oracle-api/Cargo.toml",
    "oracle:api:test": "cargo test --locked --manifest-path backend/services/oracle-api/Cargo.toml",
    "microservices:test": "cargo test --locked --manifest-path backend/services/identity-service/Cargo.toml && cargo test --locked --manifest-path backend/services/operations-service/Cargo.toml && cargo test --locked --manifest-path backend/services/realtime-service/Cargo.toml && cargo test --locked --manifest-path backend/services/monitoring-service/Cargo.toml",
    "oracle:deploy": "./scripts/services/deploy-oracle-data-processing.sh",
    "oracle:deploy:api": "./scripts/services/deploy-oracle-api.sh",
    "oracle:deploy:nutrition": "./scripts/services/deploy-oracle-data-processing.sh",
    "oracle:deploy:data-processing": "./scripts/services/deploy-oracle-data-processing.sh",
    "oracle:deploy:identity": "./scripts/services/deploy-oracle-identity.sh",
    "oracle:deploy:read": "./scripts/services/deploy-oracle-read.sh",
    "oracle:deploy:write": "./scripts/services/deploy-oracle-write.sh",
    "oracle:deploy:operations": "./scripts/services/deploy-oracle-operations.sh",
    "oracle:deploy:realtime": "./scripts/services/deploy-oracle-realtime.sh",
    "oracle:deploy:monitoring": "./scripts/services/deploy-oracle-monitoring.sh",
    "oracle:deploy:all": "./scripts/services/deploy-oracle-all.sh",
    "oracle:cutover:check": "./scripts/operations/check-oracle-cutover.sh",
    "replica:bootstrap": "./scripts/database/bootstrap-neon-read-replica.sh",
    "replica:verify": "./scripts/database/verify-neon-read-replica.sh",
    "data-processing:connect:render": "./scripts/services/connect-render-data-processing.sh",
    "data-processing:deploy:oracle": "./scripts/services/deploy-oracle-data-processing.sh",
    "data-processing:connect:oracle": "./scripts/services/connect-oracle-data-processing.sh",
    "data-processing:activate:macos": "./scripts/services/activate-data-processing-worker-macos.sh",
    "data-processing:install:macos": "./scripts/services/install-data-processing-worker-macos.sh",
    "grpc:connect:render": "npm run data-processing:connect:render",
    "grpc:deploy:oracle": "npm run data-processing:deploy:oracle",
    "grpc:connect:oracle": "npm run data-processing:connect:oracle",
    "grpc:activate:macos": "npm run data-processing:activate:macos",
    "grpc:install:macos": "npm run data-processing:install:macos",
    "pages:build": "npm run pages:build:react",
    "pages:build:staging": "VITE_APP_ENV=staging VITE_API_URL= npm --prefix frontend run build -- --mode staging",
    "pages:deploy": "npm run pages:build:react && npx --yes wrangler pages deploy frontend/dist --project-name e-posyandu --branch main",
    "pages:deploy:staging": "npm run pages:build:staging && npx --yes wrangler pages deploy frontend/dist --project-name e-posyandu-staging --branch staging",
    "preview": "npm --prefix frontend run preview"
  }
}
